# systemd unit for bgpfcd (README, "Option A"): an unprivileged user with
# the two capabilities the daemon needs. With `rpki { mode sidecar; }`
# bgpfcd also runs Routinator 0.15.x (/usr/bin/routinator, with rsync on
# PATH) as this same user, with no capabilities, and stops it itself
# (README, "Routinator sidecar"). Install with
#   install -m 644 contrib/bgpfcd.service /etc/systemd/system/
#   useradd --system --home /run/bgpfc --shell /usr/sbin/nologin bgpfc
#   systemctl daemon-reload && systemctl enable --now bgpfcd
[Unit]
Description=bgpfc BGP-4 routing daemon
Documentation=https://github.com/ahadley1124/bgpfc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bgpfc
Group=bgpfc
ExecStartPre=/usr/local/bin/bgpfcd -c /etc/bgpfc/bgpfc.conf --check
ExecStart=/usr/local/bin/bgpfcd -c /etc/bgpfc/bgpfc.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
# bgpfcd stops Routinator itself: SIGTERM goes to bgpfcd alone, which
# shuts down in order (Cease, FIB cleanup, RTR client, then Routinator
# with SIGTERM and, after its stop-timeout, SIGKILL). systemd's SIGKILL
# reaches whatever is left in the cgroup only after bgpfcd has exited.
# With the default KillMode=control-group, Routinator would get SIGTERM
# at the same moment as bgpfcd, and its supervisor, seeing an exit it did
# not ask for, could start it again before the shutdown reached it.
KillMode=mixed
# FIB cleanup (up to 10 s), the sidecar's stop-timeout (10 s by default)
# and a Routinator version check that may be running (up to 10 s).
TimeoutStopSec=40
# Also retries a start that fails, such as one with a Routinator of
# another release, every 5 s, with the reason in the journal.
Restart=on-failure
RestartSec=5

# CAP_NET_BIND_SERVICE for port 179, CAP_NET_ADMIN for install mode.
# Routinator gets neither: bgpfcd clears its ambient set for the child.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
# Also makes a `user` or `group` in a Routinator config file fail loudly,
# rather than switch users and lose the signal that ends Routinator when
# bgpfcd dies.
NoNewPrivileges=yes
RuntimeDirectory=bgpfc
ConfigurationDirectory=bgpfc
# /var/lib/bgpfc: Routinator's repository (repository-dir, by default
# /var/lib/bgpfc/rpki), writable under ProtectSystem=strict.
StateDirectory=bgpfc
StateDirectoryMode=0750
# Keep the soft LimitNOFILE modest: before each Routinator start the
# sidecar marks every descriptor up to it close-on-exec.

# Hardening: nothing below is needed by the daemon.
ProtectSystem=strict
# Routinator's HOME is its repository directory, not a home directory.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Routinator fetches over AF_INET and AF_INET6: RRDP (HTTPS) and rsync.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# Routinator does not need writable executable memory either.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
