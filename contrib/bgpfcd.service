# systemd unit for bgpfcd (README, "Option A"): an unprivileged user with
# the two capabilities the daemon needs. With `rpki { mode sidecar; }`
# bgpfcd also runs Routinator 0.15.x (/usr/bin/routinator, with rsync on
# PATH) as this same user, with no capabilities, and stops it itself
# (README, "Routinator sidecar"). Install with
#   install -m 644 contrib/bgpfcd.service /etc/systemd/system/
#   useradd --system --home /run/bgpfc --shell /usr/sbin/nologin bgpfc
#   systemctl daemon-reload && systemctl enable --now bgpfcd
[Unit]
Description=bgpfc BGP-4 routing daemon
Documentation=https://github.com/ahadley1124/bgpfc
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bgpfc
Group=bgpfc
ExecStartPre=/usr/local/bin/bgpfcd -c /etc/bgpfc/bgpfc.conf --check
ExecStart=/usr/local/bin/bgpfcd -c /etc/bgpfc/bgpfc.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
# bgpfcd stops Routinator itself: SIGTERM goes to bgpfcd alone, which
# shuts down in order (Cease, RTR client, then Routinator with SIGTERM
# and, after its stop-timeout, SIGKILL, while the FIB is cleaned up).
# systemd's SIGKILL reaches whatever is left in the cgroup only after
# bgpfcd has exited: nothing after a clean stop, and after a crash or
# SIGKILL of bgpfcd, the rsync Routinator may have been running, which the
# kernel's parent-death signal for Routinator does not reach. With the
# default KillMode=control-group, Routinator would get SIGTERM at the same
# moment as bgpfcd, before the RTR client lets go of it, and bgpfcd would
# log an exit it did not ask for.
KillMode=mixed
# Routinator's stop, during the FIB cleanup (up to 10 s): its stop-timeout
# (10 s by default) and a version check that may be running (up to 10 s).
TimeoutStopSec=40
# Also retries a start that fails, such as one with a Routinator of
# another release, every 5 s, with the reason in the journal.
Restart=on-failure
RestartSec=5

# CAP_NET_BIND_SERVICE for port 179, CAP_NET_ADMIN for install mode.
# Routinator gets neither: bgpfcd clears its ambient set for the child.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

# Network namespace (README, "Network namespace"). Either let systemd put
# bgpfcd in it, which needs no capability:
#NetworkNamespacePath=/run/netns/NAME
# or have bgpfcd join it itself (`--netns NAME`, or `netns NAME;` in the
# file), which needs CAP_SYS_ADMIN for setns(2), dropped right after the
# join. The empty assignments drop the lines above; and set
# RestrictNamespaces=net in place of the RestrictNamespaces=yes below,
# which blocks setns(2).
#ExecStartPre=
#ExecStartPre=/usr/local/bin/bgpfcd -c /etc/bgpfc/bgpfc.conf --check --netns NAME
#ExecStart=
#ExecStart=/usr/local/bin/bgpfcd -c /etc/bgpfc/bgpfc.conf --netns NAME
#AmbientCapabilities=
#AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN
#CapabilityBoundingSet=
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN
# Also makes a `user` or `group` in a Routinator config file fail loudly,
# rather than switch users and lose the signal that ends Routinator when
# bgpfcd dies.
NoNewPrivileges=yes
RuntimeDirectory=bgpfc
ConfigurationDirectory=bgpfc
# /var/lib/bgpfc: Routinator's repository (repository-dir, by default
# /var/lib/bgpfc/rpki), writable under ProtectSystem=strict.
StateDirectory=bgpfc
StateDirectoryMode=0750
# Keep the soft LimitNOFILE modest: before each Routinator start the
# sidecar marks every descriptor up to it close-on-exec.

# Hardening: nothing below is needed by the daemon.
ProtectSystem=strict
# Routinator's HOME is its repository directory, not a home directory.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Routinator fetches over AF_INET and AF_INET6: RRDP (HTTPS) and rsync.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
# `net` instead when bgpfcd joins a network namespace itself (above):
# setns(2) into a network namespace, and no other namespace.
RestrictNamespaces=yes
LockPersonality=yes
# Routinator does not need writable executable memory either.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
